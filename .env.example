LUNAR_CORS_ORIGINS=http://localhost:3000
LUNAR_CACHE_TTL_SECONDS=900
LUNAR_HORIZONS_URL=https://ssd.jpl.nasa.gov/api/horizons.api
LUNAR_MOONTREK_BASE=https://trek.nasa.gov
LUNAR_QUICKMAP_URL=https://quickmap.lroc.asu.edu/
# Configure these only after validating a genuine elevation raster and label/SIS.
# The DEM file must resolve within the approved directory; requests cannot supply paths.
LUNAR_DEM_ROOT=
LUNAR_DEM_PATH=
# Exact body-fixed coordinate frame IDs must be documented and match.
# Example frame strings are not defaults; confirm site and DEM metadata first.
LUNAR_SITE_COORDINATE_FRAME_ID=
LUNAR_DEM_COORDINATE_FRAME_ID=
